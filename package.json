{
	"name": "n8n-nodes-dsers",
	"version": "0.1.0",
	"description": "DSers MCP tools for n8n dropshipping workflows, with OAuth2 authentication.",
	"license": "MIT",
	"homepage": "https://www.dsers.com/",
	"keywords": [
		"n8n-community-node-package",
		"dsers",
		"mcp",
		"dropshipping"
	],
	"author": {
		"name": "DSers",
		"url": "https://www.dsers.com/",
		"email": "support@dsers.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dsers/dsers-n8n-nodes.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "npm run check",
		"test": "node --test tests/*.test.cjs",
		"test:simulation": "node scripts/run-simulation-tests.cjs",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write credentials nodes tests scripts package.json README.md docs examples .github",
		"check": "npm run typecheck && npm run lint && npm run build && npm test"
	},
	"files": [
		"dist",
		"docs",
		"examples"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DsersOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Dsers/Dsers.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.4",
		"n8n-workflow": "2.16.0",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/dsers/dsers-n8n-nodes/issues"
	},
	"engines": {
		"node": ">=22.16"
	},
	"publishConfig": {
		"access": "public"
	}
}
